# Configuración de Base de Datos MongoDB Atlas
# MONGO_URI encriptada en el código por seguridad
# MONGO_URI=mongodb+srv://[encrypted]

# Configuración JWT
JWT_SECRET=docusmart-super-secret-key-2024-panama-jwt-256-bits
JWT_EXPIRES_IN=7d

# Configuración del Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Configuración OpenAI para Generación de Contratos
OPENAI_API_KEY=sk-tu-clave-openai-aqui

# Configuración PAC (Proveedor Autorizado de Certificación)
PAC_API_URL=https://api-pac-sandbox.com/v1
PAC_API_KEY=tu-clave-pac-aqui
PAC_ENVIRONMENT=sandbox

# Configuración DGI Panamá
DGI_API_URL=https://api.dgi.gob.pa/v1
DGI_CERTIFICATE_PATH=./certificates/dgi-cert.pem

# Configuración de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-password-app

# Configuración de Logs
LOG_LEVEL=info
LOG_FILE=./logs/docusmart.log

# Configuración de Archivos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# URLs de Despliegue
RENDER_URL=https://docusmart-backend.onrender.com
GITHUB_PAGES_URL=https://aalvarez351.github.io/DocuSmart