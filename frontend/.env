# Configuración del API Backend
VITE_API_URL=http://localhost:3000/api
VITE_API_URL_PROD=https://docusmart-backend.onrender.com/api

# Configuración de la Aplicación
VITE_APP_NAME=DocuSmart
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Asistente Legal-Contable con IA para PYMEs

# Configuración de Despliegue
VITE_GITHUB_PAGES_URL=https://aalvarez351.github.io/DocuSmart
VITE_RENDER_URL=https://docusmart-backend.onrender.com

# Configuración de Desarrollo
VITE_DEV_MODE=true
VITE_DEBUG=true

# URLs de Servicios Externos
VITE_DGI_CONSULTA_URL=https://www.dgi.gob.pa/consultas
VITE_PAC_DEMO_URL=https://demo-pac.com

# Configuración de Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHAT_SUPPORT=false
VITE_ENABLE_NOTIFICATIONS=true

# Configuración Regional
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_LOCALE=es-PA
VITE_DEFAULT_TIMEZONE=America/Panama